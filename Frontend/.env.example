# Copy this file to .env.local (gitignored) and fill in the values.
# These are only read by the dev server's /api proxy and are never sent to the browser.

# Backend that /api requests go to. Use http://127.0.0.1:8000 for a backend running locally.
API_TARGET=https://bisonrides-api.onrender.com

# The backend's API key (ask the team). Sent as the x-key header.
API_KEY=

# Stripe's publishable key (pk_test_... while testing). Unlike the two above, this one IS sent to the
# browser, which is fine: it can only start payments, never move money. Leave empty to hide payments.
VITE_STRIPE_PUBLISHABLE_KEY=
